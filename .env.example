# Telecheck Healthcare - Environment Configuration

# Application Settings
NODE_ENV=development
PORT=8080

# Database Configuration (Choose one method)
# Method 1: Connection String (recommended for DigitalOcean Managed Database)
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Method 2: Individual Parameters (alternative)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=telecheck
# DB_USER=postgres
# DB_PASSWORD=your_password

# Authentication
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# OAuth Configuration
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# Keycloak SSO (Production-Ready Configuration)
# ================================================================
# Keycloak Realm Configuration
KEYCLOAK_REALM=telecheck
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8180

# Web Application Client (Public Client with PKCE)
KEYCLOAK_CLIENT_ID=telecheck-web
KEYCLOAK_CLIENT_SECRET=your-keycloak-web-client-secret-from-setup-script

# API Service Account Client (Confidential Client)
KEYCLOAK_ADMIN_CLIENT_ID=telecheck-api
KEYCLOAK_ADMIN_CLIENT_SECRET=your-keycloak-api-client-secret-from-setup-script

# Token Configuration (in seconds)
KEYCLOAK_TOKEN_LIFESPAN=900            # Access token: 15 minutes
KEYCLOAK_REFRESH_TOKEN_LIFESPAN=1800   # Refresh token: 30 minutes

# Security Configuration
KEYCLOAK_VALIDATE_ISSUER=true          # Validate token issuer claim
KEYCLOAK_VALIDATE_AUDIENCE=true        # Validate token audience claim
KEYCLOAK_REQUIRE_HTTPS=false           # Set to true in production

# Frontend Configuration
FRONTEND_URL=http://localhost:8080     # Your frontend URL for redirects

# OAuth General Settings
OAUTH_ENABLED=true
OAUTH_SESSION_SECRET=your-oauth-session-secret-minimum-32-characters

# Messaging Services (SMS)
TELNYX_API_KEY=your-telnyx-api-key-here
TELNYX_PHONE_NUMBER=+1234567890
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Email Service Configuration (choose one provider)
# Option 1: SMTP (Generic - Gmail, Outlook, etc.)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@telecheck.com

# Option 2: SendGrid
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=your-sendgrid-api-key
# EMAIL_FROM=noreply@telecheck.com

# Option 3: AWS SES
# EMAIL_PROVIDER=ses
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# EMAIL_FROM=noreply@telecheck.com

# Optional: External Services
OPENAI_API_KEY=your-openai-api-key
STRIPE_SECRET_KEY=your-stripe-secret-key

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Session Configuration
SESSION_SECRET=your-session-secret-key

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:8080,https://yourdomain.com

# Development Settings
VITE_WS_URL=ws://localhost:8080
DEBUG=telecheck:*

# Production Settings (uncomment for production)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
# FORCE_HTTPS=true

# DigitalOcean Specific (automatically set by App Platform)
# DATABASE_URL will be automatically injected by DigitalOcean Managed Database
# No need to set manually when using App Platform

# Backup Configuration
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30
