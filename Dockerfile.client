# =============================================================================
# Telecheck V2.0 - Production Web Client Dockerfile
#
# Purpose: Multi-stage Docker build for production web deployment
# Security: Non-root nginx user, read-only filesystem
# Size Target: < 150MB (nginx:alpine + static assets)
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Build Stage
# -----------------------------------------------------------------------------
FROM node:18-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install dependencies
RUN npm ci --only=production=false

# Copy client source code
COPY client/ ./client/
COPY shared/ ./shared/
COPY index.html ./
COPY vite.config.ts ./

# Build production bundle
RUN npm run build:client

# -----------------------------------------------------------------------------
# Stage 2: Production Stage (NGINX)
# -----------------------------------------------------------------------------
FROM nginx:1.25-alpine AS production

# Copy NGINX configuration
COPY infrastructure/nginx/nginx.client.conf /etc/nginx/nginx.conf

# Copy built static files
COPY --from=builder /app/dist/client /usr/share/nginx/html

# Create non-root nginx user (if not exists)
RUN addgroup -g 101 -S nginx || true && \
    adduser -S nginx -u 101 -G nginx || true

# Set proper permissions
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid

# Remove default nginx config
RUN rm -f /etc/nginx/conf.d/default.conf

# Switch to non-root user
USER nginx

# Expose port 80 (TLS termination at load balancer)
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:80/health.html || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
