# Local Development Environment Configuration
NODE_ENV=development

# Secrets management
SECRETS_PROVIDER=file,env
SECRETS_FILE=./secrets.local.json
# To test AWS Secrets Manager locally (e.g., via LocalStack), uncomment and configure:
# SECRETS_PROVIDER=aws-sm,file,env
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=localstack-access-key
# AWS_SECRET_ACCESS_KEY=localstack-secret-key
# AWS_SESSION_TOKEN=
# AWS_SECRETS_MANAGER_ENDPOINT=http://localhost:4566
# AWS_SECRETS_MANAGER_CACHE_TTL_MS=60000
# DATABASE_URL_SECRET_REF=
# DB_PASSWORD_SECRET_REF=
# REDIS_PASSWORD_SECRET_REF=
# DB_SSL_CA_SECRET_REF=
# DB_SSL_CERT_SECRET_REF=
# DB_SSL_KEY_SECRET_REF=

# Local PostgreSQL (Docker container)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=telecheck
DB_USER=postgres
DB_PASSWORD=password
DB_MAX_CONNECTIONS=20

# Local Redis (Docker container)
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=dev-secret-key-change-in-production

# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:8080

# Security Configuration (relaxed for local development)
CORS_ORIGIN=http://localhost:8080
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# SSL Configuration (disabled for local development)
DB_SSL=false

# Demo Controls
ENABLE_DEMO_AUTH_BYPASS=false

# Logging & Observability
SERVICE_NAME=telecheck-api
LOG_LEVEL=debug
# LOG_FORWARD_ENDPOINT=
# LOG_FORWARD_AUTH=
# LOG_FORWARD_API_KEY=

# Feature Flags
# FEATURE_FLAGS_FILE=./feature-flags.local.json
# FEATURE_FLAGS=insights-redesign=true,ai-scribe=false

# Administrative bootstrap (set only when running `npm run bootstrap:admin`)
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_FIRST_NAME=
# ADMIN_BOOTSTRAP_LAST_NAME=
# ADMIN_BOOTSTRAP_ROLE=admin
# ADMIN_BOOTSTRAP_ROTATE=false
