# Production Environment Configuration
NODE_ENV=production

# Secrets management
SECRETS_PROVIDER=aws-sm,file,env
# Point to an encrypted JSON bundle or leave unset to default to `secrets.local.json`
# SECRETS_FILE=/etc/telecheck/secrets.json
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-iam-access-key
AWS_SECRET_ACCESS_KEY=your-iam-secret
# Optional for temporary credentials or VPC endpoints
# AWS_SESSION_TOKEN=
# AWS_SECRETS_MANAGER_ENDPOINT=https://secretsmanager.us-east-1.amazonaws.com
# AWS_SECRETS_MANAGER_CACHE_TTL_MS=60000
DATABASE_URL_SECRET_REF=secret://database/primary#url
DB_PASSWORD_SECRET_REF=secret://database/primary#password
REDIS_PASSWORD_SECRET_REF=secret://redis#password
# Optional TLS certificates/keys (required when DB_SSL=true)
# DB_SSL_CA_SECRET_REF=secret://database/tls#ca
# DB_SSL_CERT_SECRET_REF=secret://database/tls#cert
# DB_SSL_KEY_SECRET_REF=secret://database/tls#key

# External PostgreSQL Configuration (Choose your service)
# Option 1: DigitalOcean Managed Database
DATABASE_URL=postgresql://username:password@host:port/database

# Option 2: Individual connection parameters
DB_HOST=your-postgres-host.com
DB_PORT=5432
DB_NAME=telecheck_prod
DB_USER=telecheck_user
DB_PASSWORD=your-secure-password
DB_MAX_CONNECTIONS=50

# External Redis Configuration (Choose your service)
# Option 1: DigitalOcean Managed Redis
REDIS_URL=redis://username:password@host:port

# Option 2: Individual Redis parameters
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Configuration
PORT=3000
FRONTEND_URL=https://telecheckhealth.com

# Security Configuration
CORS_ORIGIN=https://telecheckhealth.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# SSL Configuration for External Database
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# Demo Controls (keep disabled in production)
ENABLE_DEMO_AUTH_BYPASS=false

# Logging & Observability
SERVICE_NAME=telecheck-api
LOG_LEVEL=info
# LOG_FORWARD_ENDPOINT=https://logs.your-siem.example.com/ingest
# LOG_FORWARD_AUTH=Bearer your-token
# LOG_FORWARD_API_KEY=

# Feature Flags
# FEATURE_FLAGS_FILE=/etc/telecheck/feature-flags.json
# FEATURE_FLAGS=insights-redesign=false,ai-scribe=true

# Administrative bootstrap (set only when running `npm run bootstrap:admin`)
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_FIRST_NAME=
# ADMIN_BOOTSTRAP_LAST_NAME=
# ADMIN_BOOTSTRAP_ROLE=admin
# ADMIN_BOOTSTRAP_ROTATE=false
