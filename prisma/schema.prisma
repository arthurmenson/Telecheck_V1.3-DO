// Telecheck Database Schema
// This schema defines the data models for the HCW video consultation integration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums for type safety
enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
  NURSE
  CAREGIVER
}

enum AppointmentStatus {
  pending
  confirmed
  active
  completed
  cancelled
}

enum AppointmentType {
  video
  in_person
}

enum VideoConsultationStatus {
  pending
  active
  completed
  cancelled
  failed
}

// User model (extends existing users table)
model User {
  id          String    @id @default(cuid())
  keycloakId  String?   @unique @map("keycloak_id") // Keycloak user ID for sync
  email       String    @unique
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  phone       String?
  role        UserRole  @default(PATIENT)

  // Profile fields
  gender  String?
  address String?
  city    String?
  state   String?
  zipCode String? @map("zip_code")

  // Emergency contact
  emergencyContactName     String? @map("emergency_contact_name")
  emergencyContactPhone    String? @map("emergency_contact_phone")
  emergencyContactRelation String? @map("emergency_contact_relation")

  // Medical information
  medicalHistory     String? @map("medical_history") @db.Text
  currentMedications String? @map("current_medications") @db.Text
  allergies          String? @db.Text

  // Insurance
  insuranceProvider     String? @map("insurance_provider")
  insurancePolicyNumber String? @map("insurance_policy_number")
  insuranceGroupNumber  String? @map("insurance_group_number")
  primaryCarePhysician  String? @map("primary_care_physician")

  // Settings - Notification Preferences
  emailNotifications       Boolean @default(true) @map("email_notifications")
  smsNotifications         Boolean @default(true) @map("sms_notifications")
  pushNotifications        Boolean @default(false) @map("push_notifications")
  appointmentNotifications Boolean @default(true) @map("appointment_notifications")
  labResultNotifications   Boolean @default(true) @map("lab_result_notifications")
  messageNotifications     Boolean @default(true) @map("message_notifications")
  reminderNotifications    Boolean @default(true) @map("reminder_notifications")

  // Settings - Privacy Controls
  dataSharing       Boolean @default(false) @map("data_sharing")
  marketingConsent  Boolean @default(false) @map("marketing_consent")
  thirdPartySharing Boolean @default(false) @map("third_party_sharing")

  // Settings - Communication Preferences
  preferredContactMethod String @default("email") @map("preferred_contact_method")
  languagePreference     String @default("en") @map("language_preference")

  // Settings - Security
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecret  String? @map("two_factor_secret")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  patientAppointments    Appointment[]              @relation("PatientAppointments")
  doctorAppointments     Appointment[]              @relation("DoctorAppointments")
  doctorProfile          DoctorProfile?
  caregiverProfile       HCWCaregiver?              @relation("CaregiverProfile")
  caregiverAssignments   HCWAssignment[]            @relation("PatientCaregivers")
  visits                 HCWVisit[]                 @relation("PatientVisits")
  carePlans              HCWCarePlan[]              @relation("PatientCarePlans")
  taskComments           HCWTaskComment[]           @relation("TaskComments")
  dataSharingPreferences HCWDataSharingPreference[] @relation("PatientDataSharing")
  documents              HCWDocument[]              @relation("PatientDocuments")
  sentMessages           HCWMessage[]               @relation("SentHCWMessages")
  receivedMessages       HCWMessage[]               @relation("ReceivedHCWMessages")

  @@index([email])
  @@map("users")
}

// DoctorProfile model for detailed provider information
model DoctorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  specialty       String
  credentials     String // "MD", "DO", "NP", etc.
  bio             String?  @db.Text
  experience      Int      @default(0) // years of experience
  rating          Float    @default(0.0)
  reviewCount     Int      @default(0) @map("review_count")
  languages       String[] @default(["English"])
  videoEnabled    Boolean  @default(true) @map("video_enabled")
  phoneEnabled    Boolean  @default(true) @map("phone_enabled")
  inPersonEnabled Boolean  @default(false) @map("in_person_enabled")
  licenseNumber   String?  @map("license_number")
  licenseState    String?  @map("license_state")
  location        String? // "Boston, MA" or "Medical Plaza, Main St"
  education       String? // "Harvard Medical School"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([specialty])
  @@index([videoEnabled])
  @@index([rating])
  @@index([userId])
  @@map("doctor_profiles")
}

// Appointment model
model Appointment {
  id                String            @id @default(cuid())
  patientId         String            @map("patient_id")
  doctorId          String            @map("doctor_id")
  scheduledTime     DateTime          @map("scheduled_time") @db.Timestamptz(6)
  type              AppointmentType   @default(video)
  status            AppointmentStatus @default(pending)
  reason            String?           @db.Text
  notes             String?           @db.Text
  hcwConsultationId String?           @unique @map("hcw_consultation_id")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  patient           User               @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctor            User               @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  videoConsultation VideoConsultation?

  @@unique([doctorId, scheduledTime], name: "no_double_booking")
  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledTime])
  @@index([status])
  @@index([patientId, scheduledTime])
  @@index([doctorId, scheduledTime])
  @@map("appointments")
}

// VideoConsultation model
model VideoConsultation {
  id                String                  @id @default(cuid())
  appointmentId     String                  @unique @map("appointment_id")
  hcwConsultationId String                  @map("hcw_consultation_id")
  patientUrl        String                  @map("patient_url") @db.Text
  doctorUrl         String?                 @map("doctor_url") @db.Text
  status            VideoConsultationStatus @default(pending)
  startedAt         DateTime?               @map("started_at") @db.Timestamptz(6)
  endedAt           DateTime?               @map("ended_at") @db.Timestamptz(6)
  duration          Int? // Duration in minutes
  errorMessage      String?                 @map("error_message") @db.Text
  metadata          Json? // Store additional HCW response data

  // Post-consultation documentation (simple approach)
  consultationNotes String? @map("consultation_notes") @db.Text
  diagnosis         String? @db.Text
  treatmentPlan     String? @map("treatment_plan") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([hcwConsultationId])
  @@index([status])
  @@index([startedAt])
  @@map("video_consultations")
}

// ConsultationNote model for post-consultation documentation
model ConsultationNote {
  id            String @id @default(cuid())
  appointmentId String @map("appointment_id")
  doctorId      String @map("doctor_id")
  patientId     String @map("patient_id")

  // Clinical documentation
  chiefComplaint       String? @map("chief_complaint") @db.Text
  historyOfPresent     String? @map("history_of_present") @db.Text
  assessment           String? @db.Text
  clinicalNotes        String? @map("clinical_notes") @db.Text
  diagnosisCodes       Json?   @map("diagnosis_codes") // Array of ICD-10 codes
  treatmentPlan        String? @map("treatment_plan") @db.Text
  followUpInstructions String? @map("follow_up_instructions") @db.Text

  // Prescription references
  prescriptionIds Json? @map("prescription_ids") // Array of eRx prescription IDs

  // Follow-up scheduling
  followUpDate DateTime? @map("follow_up_date") @db.Timestamptz(6)
  followUpType String?   @map("follow_up_type") // video, in_person, phone

  // Status tracking
  status   String    @default("draft") // draft, completed, signed
  isDraft  Boolean   @default(true) @map("is_draft")
  signedAt DateTime? @map("signed_at") @db.Timestamptz(6)

  // Audit fields
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) // For tracking note versions

  @@index([appointmentId])
  @@index([doctorId])
  @@index([patientId])
  @@index([status])
  @@index([createdAt])
  @@map("consultation_notes")
}

// ConsultationNoteAudit for tracking all changes to notes (HIPAA compliance)
model ConsultationNoteAudit {
  id           String   @id @default(cuid())
  noteId       String   @map("note_id")
  userId       String   @map("user_id")
  action       String // created, updated, signed, viewed
  fieldChanged String?  @map("field_changed")
  oldValue     String?  @map("old_value") @db.Text
  newValue     String?  @map("new_value") @db.Text
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  timestamp    DateTime @default(now()) @db.Timestamptz(6)

  @@index([noteId])
  @@index([userId])
  @@index([timestamp])
  @@map("consultation_note_audits")
}

// PatientConsultationSummary for email/in-app summaries
model PatientConsultationSummary {
  id            String @id @default(cuid())
  appointmentId String @unique @map("appointment_id")
  patientId     String @map("patient_id")
  doctorId      String @map("doctor_id")

  // Summary content
  summaryHtml      String @map("summary_html") @db.Text
  summaryPlainText String @map("summary_plain_text") @db.Text

  // Delivery tracking
  emailSent       Boolean   @default(false) @map("email_sent")
  emailSentAt     DateTime? @map("email_sent_at") @db.Timestamptz(6)
  viewedByPatient Boolean   @default(false) @map("viewed_by_patient")
  viewedAt        DateTime? @map("viewed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([appointmentId])
  @@index([patientId])
  @@index([doctorId])
  @@index([emailSent])
  @@map("patient_consultation_summaries")
}

// MedicalTemplate for common condition templates
model MedicalTemplate {
  id        String  @id @default(cuid())
  name      String
  category  String // respiratory, cardiac, dermatology, etc.
  specialty String? // primary_care, urgent_care, etc.

  // Template content
  chiefComplaintTemplate String? @map("chief_complaint_template") @db.Text
  historyTemplate        String? @map("history_template") @db.Text
  assessmentTemplate     String? @map("assessment_template") @db.Text
  treatmentPlanTemplate  String? @map("treatment_plan_template") @db.Text
  followUpTemplate       String? @map("follow_up_template") @db.Text

  // Common ICD-10 codes for this template
  commonDiagnosisCodes Json? @map("common_diagnosis_codes")

  // Usage tracking
  usageCount Int     @default(0) @map("usage_count")
  isActive   Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([category])
  @@index([specialty])
  @@index([isActive])
  @@map("medical_templates")
}

// ===================================
// HCW@Home Care Team Integration
// ===================================

// HCWCaregiver model for home healthcare workers
model HCWCaregiver {
  id          String  @id @default(cuid())
  userId      String  @unique @map("user_id")
  hcwUserId   String? @unique @map("hcw_user_id") // ID in HCW@Home system
  specialty   String
  credentials String
  bio         String? @db.Text
  phoneNumber String? @map("phone_number")
  email       String
  isActive    Boolean @default(true) @map("is_active")

  user                   User                       @relation("CaregiverProfile", fields: [userId], references: [id], onDelete: Cascade)
  assignments            HCWAssignment[]
  visits                 HCWVisit[]
  dataSharingPreferences HCWDataSharingPreference[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([specialty])
  @@index([isActive])
  @@map("hcw_caregivers")
}

// HCWAssignment model for patient-caregiver relationships
model HCWAssignment {
  id             String    @id @default(cuid())
  patientId      String    @map("patient_id")
  caregiverId    String    @map("caregiver_id")
  assignedAt     DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  isPrimary      Boolean   @default(false) @map("is_primary")
  status         String    @default("active") // active, inactive, transferred
  endDate        DateTime? @map("end_date") @db.Timestamptz(6)
  assignmentType String?   @map("assignment_type") // primary_care, home_health, specialist, care_coordinator
  notes          String?   @db.Text

  patient   User         @relation("PatientCaregivers", fields: [patientId], references: [id], onDelete: Cascade)
  caregiver HCWCaregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([patientId])
  @@index([caregiverId])
  @@index([status])
  @@index([isPrimary])
  @@map("hcw_assignments")
}

// HCWVisit model for home health visits
model HCWVisit {
  id                 String    @id @default(cuid())
  patientId          String    @map("patient_id")
  caregiverId        String    @map("caregiver_id")
  scheduledTime      DateTime  @map("scheduled_time") @db.Timestamptz(6)
  actualStart        DateTime? @map("actual_start") @db.Timestamptz(6)
  actualEnd          DateTime? @map("actual_end") @db.Timestamptz(6)
  visitType          String    @map("visit_type") // routine, urgent, follow_up, initial_assessment
  purpose            String    @db.Text
  location           String? // for home visits, patient address
  notes              String?   @db.Text
  status             String    @default("scheduled") // scheduled, in_progress, completed, cancelled, no_show
  rating             Int? // 1-5 star rating from patient
  feedback           String?   @db.Text
  cancellationReason String?   @map("cancellation_reason") @db.Text

  patient   User         @relation("PatientVisits", fields: [patientId], references: [id], onDelete: Cascade)
  caregiver HCWCaregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([patientId])
  @@index([caregiverId])
  @@index([scheduledTime])
  @@index([status])
  @@map("hcw_visits")
}

// HCWMessage model for patient-caregiver messaging
model HCWMessage {
  id            String    @id @default(cuid())
  senderId      String    @map("sender_id")
  senderType    String    @default("patient") @map("sender_type") // "patient" or "caregiver"
  recipientId   String    @map("recipient_id")
  recipientType String    @default("caregiver") @map("recipient_type") // "patient" or "caregiver"
  content       String    @db.Text
  attachments   Json? // Array of attachment URLs or metadata
  isRead        Boolean   @default(false) @map("is_read")
  readAt        DateTime? @map("read_at") @db.Timestamptz(6)
  threadId      String?   @map("thread_id") // for grouping conversations
  messageType   String    @default("text") @map("message_type") // text, voice, video_request, system
  priority      String    @default("normal") // normal, urgent, high

  // Relations now reference User table instead of HCWCaregiver
  sender    User @relation("SentHCWMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedHCWMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([senderId])
  @@index([recipientId])
  @@index([threadId])
  @@index([isRead])
  @@index([createdAt])
  @@map("hcw_messages")
}

// HCWCarePlan model for patient care plans
model HCWCarePlan {
  id          String    @id @default(cuid())
  patientId   String    @map("patient_id")
  caregiverId String    @map("caregiver_id")
  title       String
  description String?   @db.Text
  startDate   DateTime  @map("start_date") @db.Timestamptz(6)
  endDate     DateTime? @map("end_date") @db.Timestamptz(6)
  status      String    @default("active") // active, completed, cancelled, on_hold
  goals       Json? // Array of care plan goals

  patient User              @relation("PatientCarePlans", fields: [patientId], references: [id], onDelete: Cascade)
  tasks   HCWCarePlanTask[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([patientId])
  @@index([caregiverId])
  @@index([status])
  @@map("hcw_care_plans")
}

// HCWCarePlanTask model for care plan tasks
model HCWCarePlanTask {
  id          String    @id @default(cuid())
  carePlanId  String    @map("care_plan_id")
  title       String
  description String?   @db.Text
  dueDate     DateTime? @map("due_date") @db.Timestamptz(6)
  frequency   String? // daily, weekly, bi_weekly, monthly, as_needed
  status      String    @default("pending") // pending, in_progress, completed, skipped, overdue
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  notes       String?   @db.Text
  priority    String    @default("medium") // low, medium, high, critical

  carePlan HCWCarePlan      @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  comments HCWTaskComment[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([carePlanId])
  @@index([status])
  @@index([dueDate])
  @@map("hcw_care_plan_tasks")
}

// HCWTaskComment model for task comments
model HCWTaskComment {
  id              String  @id @default(cuid())
  taskId          String  @map("task_id")
  userId          String  @map("user_id")
  comment         String  @db.Text
  isSystemComment Boolean @default(false) @map("is_system_comment")

  task HCWCarePlanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User            @relation("TaskComments", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([taskId])
  @@index([userId])
  @@map("hcw_task_comments")
}

// HCWDataSharingPreference model for patient data access control
model HCWDataSharingPreference {
  id          String    @id @default(cuid())
  patientId   String    @map("patient_id")
  caregiverId String    @map("caregiver_id")
  dataType    String    @map("data_type") // labs, medications, vitals, medical_history, family_history, mental_health
  canView     Boolean   @default(true) @map("can_view")
  canEdit     Boolean   @default(false) @map("can_edit")
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  grantedBy   String?   @map("granted_by") // user_id who granted access

  patient   User         @relation("PatientDataSharing", fields: [patientId], references: [id], onDelete: Cascade)
  caregiver HCWCaregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([patientId, caregiverId, dataType])
  @@index([patientId])
  @@index([caregiverId])
  @@map("hcw_data_sharing_preferences")
}

// HCWDocument model for shared documents
model HCWDocument {
  id          String  @id @default(cuid())
  patientId   String  @map("patient_id")
  caregiverId String? @map("caregiver_id")
  uploadedBy  String  @map("uploaded_by") // user_id
  fileName    String  @map("file_name")
  fileSize    Int     @map("file_size") // bytes
  fileType    String  @map("file_type") // pdf, jpg, png, etc
  fileUrl     String  @map("file_url") @db.Text
  category    String // lab_result, imaging, discharge_summary, care_instruction, educational
  description String? @db.Text
  isShared    Boolean @default(false) @map("is_shared")
  sharedWith  Json?   @map("shared_with") // Array of caregiver IDs

  patient User @relation("PatientDocuments", fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([patientId])
  @@index([caregiverId])
  @@index([category])
  @@map("hcw_documents")
}
